; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RunePool"
config/version="1.0"
run/main_scene="uid://bi512b77cgbi0"
config/features=PackedStringArray("4.8", "Forward Plus")

[audio]

buses/default_bus_layout="uid://dwi7ro6hxqo72"

[autoload]

Global="*res://scripts/global.gd"
Controls="*uid://ogi7p0au6aa"
Settings="*uid://bbsjublrboqyk"
Transition="*uid://dhbdjefntl0pt"
AudioManager="*uid://bypupedvixfy4"
SaveManager="*uid://b7jk6y7aprrb2"
SettingsManager="*uid://ds7yrrkk3i0g6"
NetworkManager="*uid://daydr2tk4pnt8"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0

[display]

window/size/viewport_width=640
window/size/viewport_height=320
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale=2.0

